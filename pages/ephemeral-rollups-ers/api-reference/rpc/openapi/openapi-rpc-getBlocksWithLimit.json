                    ],
                    "default": "getBlocksWithLimit"
                  },
                  "jsonrpc": {
                    "type": "string",
                    "enum": [
                      "2.0"
                    ],
                    "default": "2.0"
                  },
                  "params": {
                    "type": "array",
                    "items": {
                      "type": [
                        "string",
                        "object"
                      ]
                    },
                    "description": "Start slot and limit. See Solana RPC docs for exact shape.",
                    "minItems": 1,
                    "maxItems": 2,
                    "default": [
